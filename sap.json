{
  "schema": "sa.plugin/1",
  "name": "bc2sa",
  "version": "0.1.0",
  "source": {
    "type": "local",
    "path": "."
  },
  "abi": {
    "plugin": 1,
    "saasm": ">=0.4.0"
  },
  "artifacts": {
    "linux-x86_64": {
      "path": "zig-out/lib/libbc2sa.so"
    }
  },
  "interfaces": {},
  "skills": ["bc2sa"],
  "permissions": {
    "fs": [
      { "op": "read", "path": "$PROJECT/**" }
    ],
    "net": [
      { "url": "http://localhost", "methods": ["GET"] },
      { "url": "http://127.0.0.1", "methods": ["GET"] }
    ],
    "env": ["HOME", "SA_*"],
    "process": {
      "spawn": true,
      "exec": [
        {
          "path": "/usr/bin/llvm-dis-23",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/lib/llvm-23/bin/llvm-dis",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-22",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-21",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-20",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-19",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-18",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-17",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-16",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-15",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/llvm-dis-14",
          "args": ["-o", "-", "*"]
        },
        {
          "path": "/usr/bin/clang",
          "args": ["-S", "-emit-llvm", "*", "-o", "-"]
        },
        {
          "path": "/usr/bin/clang-23",
          "args": ["-S", "-emit-llvm", "*", "-o", "-"]
        },
        {
          "path": "/usr/lib/llvm-23/bin/clang",
          "args": ["-S", "-emit-llvm", "*", "-o", "-"]
        }
      ]
    }
  },
  "dependencies": {}
}
